{
  "name": "agent-usage",
  "version": "0.1.1",
  "description": "Windows tray app: live Claude quotas + cross-agent token/cost tracking",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer.js",
    "build:widget": "esbuild src/renderer/widget.ts --bundle --outfile=dist/widget.js",
    "build:css": "tailwindcss -i src/renderer/input.css -o dist/output.css --minify",
    "build:html": "node -e \"require('fs').copyFileSync('src/renderer/index.html','dist/index.html');require('fs').copyFileSync('src/renderer/widget.html','dist/widget.html')\"",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:widget && npm run build:css && npm run build:html",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "io.bozic.agent-usage",
    "productName": "Agent Usage",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "antoniosumak",
      "repo": "agent-usage-tray",
      "releaseType": "release"
    }
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
